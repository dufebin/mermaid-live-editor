[Unit]
Description=mermaid-live-editor server (static + API, 0.0.0.0:3000)
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/opensource/mermaid-live-editor
# build with: pnpm build:prod ; install with: bash install.sh
ExecStart=/data/opensource/mermaid-live-editor/bin/mermaid-server
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=STATIC_DIR=/data/opensource/mermaid-live-editor/bin/static
Environment=DATA_DIR=/data/opensource/mermaid-live-editor/server-data
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
