[Unit]
Description=mermaid-live-editor production (Go static + API, 0.0.0.0:3000)
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/opensource/mermaid-live-editor
# build with: pnpm build:prod
ExecStart=/data/opensource/mermaid-live-editor/bin/mermaid-storage
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=STATIC_DIR=bin/static
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
